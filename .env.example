# 이 파일을 복사해 이름을 정확히 .env 로 바꾸고 값을 채움(.env 는 .gitignore 로 깃허브에 올라가지 않음)
# 배포한 앱에서는 같은 이름으로 Streamlit Secrets 에 넣음
OPENROUTER_API_KEY="sk-or-v1-여기에-자기-키"
DATABASE_URL="Supabase에서 복사한 Session pooler 주소"
ADMIN_PASSWORD="정한 관리자 비밀번호"
# (선택) 1차,2차,3차 모델을 바꾸고 싶을 때 쉼표로 구분해 넣음
# OPENROUTER_MODELS="모델1:free,모델2:free,모델3:free"
